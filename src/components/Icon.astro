---
/** Authored 24px icons, one stroke weight. Decorative unless a label is passed. */
interface Props {
  name:
    | 'bag'
    | 'menu'
    | 'close'
    | 'minus'
    | 'plus'
    | 'chevron-left'
    | 'chevron-right'
    | 'whatsapp'
    | 'facebook'
    | 'tiktok'
    | 'instagram';
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  bag: 'M5.5 8h13l-1 12h-11l-1-12Z M9 8V6.5a3 3 0 0 1 6 0V8',
  menu: 'M4 7h16 M4 12h16 M4 17h16',
  close: 'M6 6l12 12 M18 6 6 18',
  minus: 'M5 12h14',
  plus: 'M12 5v14 M5 12h14',
  'chevron-left': 'M15 5l-7 7 7 7',
  'chevron-right': 'M9 5l7 7-7 7',
  facebook: 'M14.5 8H17V4.5h-2.5A3.5 3.5 0 0 0 11 8v2.5H8.5V14H11v6.5h3.5V14H17l.5-3.5h-3V8.5a.5.5 0 0 1 .5-.5Z',
  tiktok: 'M13.5 3.5v11.25a3.25 3.25 0 1 1-3.25-3.25 M13.5 3.5c.4 2.6 2.2 4.4 5 4.6',
  instagram:
    'M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17 7h.01',
  whatsapp:
    'M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z M9.2 8.2c.3-.4.7-.4 1-.2l.9 1.8c.1.3 0 .6-.2.8l-.6.6c.6 1.2 1.6 2.2 2.8 2.8l.6-.6c.2-.2.5-.3.8-.2l1.8.9c.3.2.3.6 0 1-.6.8-1.5 1.1-2.4.8-2.4-.8-4.3-2.7-5.1-5.1-.3-.9 0-1.8.4-2.6Z',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
