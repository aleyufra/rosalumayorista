---
import { Picture } from 'astro:assets';
import MarketTag from './MarketTag.astro';
import { getCategoryLabels, productUrl, type Product } from '../lib/products';
import { formatPrice } from '../lib/price';

interface Props {
  product: Product;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Molde para scripts/catalog.ts: renderiza todas las variantes (agotado, ejemplo) para que el script saque las que no van. */
  template?: boolean;
}

const { product, eager = false, headingLevel: Heading = 'h3', template = false } = Astro.props;
const { name, cashPrice, photos, available, category, isSample } = product.data;
const cover = photos[0];
const CATEGORY_LABELS = await getCategoryLabels();
---

<article class:list={['card', { 'sold-out': !available }]} data-slug={product.id}>
  <a href={productUrl(product.id)} class="card-link">
    <div class="photo">
      {cover && (
        <Picture
          src={cover}
          alt={name}
          formats={['webp']}
          fallbackFormat="webp"
          widths={[300, 540]}
          sizes="(min-width: 87.5rem) 17rem, (min-width: 64rem) 20vw, (min-width: 48rem) 25vw, 50vw"
          loading={eager ? 'eager' : 'lazy'}
          data-vt-photo={product.id}
          class="lg:p-0"
        />
      )}
      {(isSample || template) && (
        <span class="sample" data-card-sample>
          Ejemplo
        </span>
      )}
      <div class="price">
        {(available || template) && (
          <MarketTag size="sm" data-card-price>
            {formatPrice(cashPrice)}
          </MarketTag>
        )}
        {(!available || template) && (
          <MarketTag size="sm" tone="charcoal" data-card-sold-out>
            Agotado
          </MarketTag>
        )}
      </div>
    </div>
    <div class="body">
      <Heading class="name" data-card-name>
        {name}
      </Heading>
      <p class="meta">
        <span data-card-category>{CATEGORY_LABELS[category] ?? category}</span>
        {(!available || template) && (
          <span class="was" data-card-was>
            {formatPrice(cashPrice)}
          </span>
        )}
      </p>
      <span class="details">Ver detalles</span>
    </div>
  </a>
</article>

<style>
  .card {
    min-width: 0;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .photo {
    position: relative;
    aspect-ratio: var(--aspect-product);
    border: 1px solid var(--color-charcoal);
    background: var(--color-white);
    border-radius: 0px;
  }

  /* Contain y no cover: las fotos verticales o anchas se ven enteras, nunca recortadas. */
  .photo :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .price {
    position: absolute;
    left: -0.35rem;
    bottom: 0.25rem;
    max-width: calc(100% - 0.5rem);
  }

  /* En la tarjeta el cartel va un poco mas chico que el SM general. */
  .price :global(.size-sm) {
    font-size: 0.95rem;
  }

  .sample {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.15rem 0.45rem;
    background: var(--color-charcoal);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.75rem;
  }

  .name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .was {
    text-decoration: line-through;
  }

  .details {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    color: var(--color-magenta-dark);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .card-link:hover .details {
    color: var(--color-charcoal);
  }

  .card-link:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .sold-out .photo :global(img) {
    filter: grayscale(1);
    opacity: 0.55;
  }
</style>
