---
import { Picture } from 'astro:assets';
import MarketTag from './MarketTag.astro';
import { CATEGORY_LABELS, productUrl, type Product } from '../lib/products';
import { formatPrice } from '../lib/price';

interface Props {
  product: Product;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { product, eager = false, headingLevel: Heading = 'h3' } = Astro.props;
const { name, cashPrice, photos, available, category, isSample } = product.data;
const cover = photos[0];
---

<article class:list={['card', { 'sold-out': !available }]} data-slug={product.id}>
  <a href={productUrl(product.id)} class="card-link">
    <div class="photo">
      {cover && (
        <Picture
          src={cover}
          alt={name}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[200, 300, 420, 600]}
          sizes="(min-width: 75rem) 18rem, (min-width: 64rem) 25vw, (min-width: 48rem) 33vw, 50vw"
          loading={eager ? 'eager' : 'lazy'}
          style={`view-transition-name: product-${product.id}`}
        />
      )}
      {isSample && <span class="sample">Ejemplo</span>}
      <div class="price">
        {available ? (
          <MarketTag size="sm">{formatPrice(cashPrice)}</MarketTag>
        ) : (
          <MarketTag size="sm" tone="charcoal">
            Agotado
          </MarketTag>
        )}
      </div>
    </div>
    <div class="body">
      <Heading class="name">{name}</Heading>
      <p class="meta">
        {CATEGORY_LABELS[category]}
        {!available && <span class="was">{formatPrice(cashPrice)}</span>}
      </p>
      <span class="details">Ver detalles</span>
    </div>
  </a>
</article>

<style>
  .card {
    min-width: 0;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .photo {
    position: relative;
    aspect-ratio: var(--aspect-product);
    background: var(--color-paper);
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .price {
    position: absolute;
    left: -0.35rem;
    bottom: 0.6rem;
    max-width: calc(100% - 0.5rem);
  }

  .sample {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.15rem 0.45rem;
    background: var(--color-charcoal);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.75rem;
  }

  .name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .was {
    text-decoration: line-through;
  }

  .details {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    color: var(--color-magenta-dark);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .card-link:hover .details {
    color: var(--color-charcoal);
  }

  .card-link:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .sold-out .photo :global(img) {
    filter: grayscale(1);
    opacity: 0.55;
  }
</style>
