---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  photos: ImageMetadata[];
  name: string;
  slug: string;
  soldOut?: boolean;
}

const { photos, name, slug, soldOut = false } = Astro.props;
const many = photos.length > 1;
---

<div class:list={['gallery', { 'sold-out': soldOut }]} data-gallery>
  <div
    class="track"
    data-track
    tabindex={many ? 0 : undefined}
    role={many ? 'region' : undefined}
    aria-roledescription={many ? 'galería' : undefined}
    aria-label={many ? `Fotos de ${name}` : undefined}
  >
    {photos.map((photo, i) => (
      <figure class="slide" data-slide>
        <Picture
          src={photo}
          alt={many ? `${name}, foto ${i + 1} de ${photos.length}` : name}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[360, 540, 720, 960, 1200]}
          sizes="(min-width: 64rem) 46rem, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          style={i === 0 ? `view-transition-name: product-${slug}` : undefined}
        />
      </figure>
    ))}
  </div>

  {many && (
    <>
      <div class="arrows">
        <button type="button" class="arrow" data-prev aria-label="Foto anterior">
          <Icon name="chevron-left" />
        </button>
        <button type="button" class="arrow" data-next aria-label="Foto siguiente">
          <Icon name="chevron-right" />
        </button>
      </div>
      <ul class="thumbs" aria-label="Elegir foto">
        {photos.map((photo, i) => (
          <li>
            <button
              type="button"
              class="thumb"
              data-thumb={i}
              aria-label={`Ver foto ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <Picture src={photo} alt="" formats={['webp']} widths={[96, 144]} sizes="4.5rem" />
            </button>
          </li>
        ))}
      </ul>
    </>
  )}
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    if (!track || slides.length < 2) continue;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: target * track.clientWidth });
    };

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => go(current() - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => go(current() + 1));
    thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    track.addEventListener(
      'scroll',
      () => {
        const i = current();
        thumbs.forEach((t, n) =>
          n === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current'),
        );
      },
      { passive: true },
    );
  }
</script>

<style>
  .gallery {
    position: relative;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--color-paper);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    aspect-ratio: var(--aspect-product);
    scroll-snap-align: start;
  }

  .slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sold-out .slide :global(img) {
    filter: grayscale(1);
    opacity: 0.6;
  }

  .arrows {
    display: none;
  }

  .thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .thumb {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 2px solid transparent;
    background: var(--color-paper);
    cursor: pointer;
    opacity: 0.6;
  }

  .thumb[aria-current='true'] {
    border-color: var(--color-charcoal);
    opacity: 1;
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .arrows {
      position: absolute;
      inset: 0 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      aspect-ratio: var(--aspect-product);
      padding-inline: 0.75rem;
      pointer-events: none;
    }

    .arrow {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      background: var(--color-white);
      color: var(--color-charcoal);
      cursor: pointer;
      pointer-events: auto;
    }

    .arrow:hover {
      background: var(--color-charcoal);
      color: var(--color-white);
    }

    .thumb {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
