---
// Aviso de cookies: solo existe si hay un ID de Google Analytics cargado en el panel. Arranca
// oculto (sin JavaScript no se carga Analytics, asi que no hay nada que preguntar) y lo muestra
// scripts/consent.ts si la persona todavia no eligio.
import Button from './Button.astro';
import { analyticsId, getSettings } from '../lib/settings';

const id = analyticsId(await getSettings());
---

{id && (
  <section class="consent" aria-label="Aviso de cookies" data-consent={id} hidden>
    <p>
      ¿Nos dejás usar cookies de Google Analytics para saber cuánta gente visita el sitio? No las
      usamos para publicidad. <a href="/cookies">Más info</a>
    </p>
    <div class="actions">
      <Button variant="outline-dark" data-consent-reject>
        Rechazar
      </Button>
      <Button data-consent-accept>Aceptar</Button>
    </div>
  </section>
)}

<script>
  import '../scripts/consent';
</script>

<style>
  .consent {
    position: fixed;
    right: 0;
    bottom: calc(var(--demo-offset, 0px) + env(safe-area-inset-bottom));
    left: 0;
    z-index: 41;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    padding: 1rem var(--gutter);
    background: var(--color-white);
    border-top: 1px solid var(--color-charcoal);
    box-shadow: 0 -6px 18px -10px rgb(0 0 0 / 0.35);
  }

  .consent[hidden] {
    display: none;
  }

  p {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-small);
  }

  a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-magenta);
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
  }
</style>
