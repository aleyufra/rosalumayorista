---
import { Picture } from 'astro:assets';
import storefrontPlaceholder from '../../assets/placeholders/storefront.webp';
import mapPlaceholder from '../../assets/placeholders/map.webp';
import Button from '../Button.astro';
import PendingValue from '../PendingValue.astro';
import { addressLine, type Settings } from '../../lib/settings';
import { summarizeHours } from '../../lib/opening-hours';
import { isPending } from '../../lib/text';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const hours = summarizeHours(settings.hours);
const hasEmbed = !isPending(settings.mapEmbedUrl);
---

<section id="donde-estamos" class="store" aria-labelledby="store-title">
  <div class="wrap grid">
    <div class="intro">
      <h2 id="store-title" class="voice-title text-h2">
        Tu catálogo siempre abierto
      </h2>
      <p class="lead measure">
        Visitá nuestro local en el centro de Jujuy, con una buena atención y variedad de productos para vos.
      </p>
    </div>

    <figure class="storefront">
      <Picture
        src={settings.photos.storefront ?? storefrontPlaceholder}
        alt="Frente del local de Rosalu en calle Gorriti"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 540, 720, 1080]}
        sizes="(min-width: 64rem) 42rem, 100vw"
      />
    </figure>

    <div class="details">
      <dl class="facts">
        <div>
          <dt>Dirección</dt>
          <dd>
            {addressLine(settings)}
            {isPending(settings.address.number) && (
              <>
                {' '}
                <PendingValue label="altura" />
              </>
            )}
          </dd>
        </div>
        <div>
          <dt>Horarios</dt>
          <dd>
            <ul>
              {hours.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="map">
        {hasEmbed ? (
          <iframe
            src={settings.mapEmbedUrl}
            title="Mapa de Rosalu en Google Maps"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
        ) : (
          <Picture
            src={mapPlaceholder}
            alt="Mapa de la zona del local"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[360, 540, 720]}
            sizes="(min-width: 64rem) 30rem, 100vw"
          />
        )}
      </div>

      {isPending(settings.mapsUrl) ? (
        <p>
          <PendingValue label="link de Cómo llegar" />
        </p>
      ) : (
        <Button href={settings.mapsUrl} variant="outline-dark" target="_blank" rel="noopener">
          Cómo llegar
        </Button>
      )}
    </div>
  </div>
</section>


<style>
  .store {
    padding-block: var(--space-section);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  h2 {
    margin: 0;
  }

  .lead {
    margin: 0.75rem 0 0;
    font-size: var(--text-lead);
  }

  .storefront {
    margin: 0 calc(var(--gutter) * -1);
  }

  .storefront :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--aspect-storefront);
    object-fit: cover;
    object-position: center 20%;
  }

  .details {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .facts {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0.2rem 0 0;
  }

  dd ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .map {
    position: relative;
    aspect-ratio: var(--aspect-map);
    background: var(--color-paper);
  }

  .map :global(img),
  .map :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .details > :global(.btn) {
    justify-self: start;
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: min-content 1fr;
      gap: 2.5rem 1.5rem;
    }

    .intro {
      grid-column: 1 / 8;
    }

    .storefront {
      grid-column: 1 / 8;
      align-self: start;
      margin: 0;
    }

    .details {
      grid-column: 8 / 13;
      grid-row: 1 / 3;
      align-self: start;
    }
  }
</style>
