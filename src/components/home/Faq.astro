---
import PendingValue from '../PendingValue.astro';
import { fillCopy, type Settings } from '../../lib/settings';
import { isPending } from '../../lib/text';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const items = settings.faq.map((f) => ({
  question: f.question,
  answer: fillCopy(settings, f.answer),
}));
---

{/* Paper by default; white when the paper Season block sits right above it. */}
<section
  class:list={['faq', { 'after-season': settings.season.active }]}
  aria-labelledby="faq-title"
>
  <div class="wrap grid">
    <h2 id="faq-title" class="voice-title text-h2">
      Preguntas frecuentes
    </h2>
    <div class="list">
      {items.map((item) => (
        <details>
          <summary>
            <span>{item.question}</span>
            <span class="mark" aria-hidden="true" />
          </summary>
          <div class="answer">
            {isPending(item.answer) ? (
              <p>
                <PendingValue label={item.answer.replace(/^todo:?\s*/i, '')} />
              </p>
            ) : (
              <p>{item.answer}</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--color-paper);
    padding-block: var(--space-section);
  }

  .after-season {
    background: var(--color-white);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  h2 {
    margin: 0;
  }

  details {
    border-bottom: 1px solid var(--color-charcoal);
  }

  details:first-child {
    border-top: 3px solid var(--color-charcoal);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Plus that turns into a minus. */
  .mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 200ms var(--ease-settle);
  }

  .mark::after {
    transform: rotate(90deg);
  }

  details[open] .mark::after {
    transform: rotate(0deg);
  }

  .answer p {
    max-width: 60ch;
    margin: 0 0 1.25rem;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 240ms var(--ease-settle),
        content-visibility 240ms allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }

  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }

    h2 {
      grid-column: 1 / 5;
      position: sticky;
      top: 6rem;
    }

    .list {
      grid-column: 5 / 13;
    }
  }
</style>
