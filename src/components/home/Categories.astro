---
import { Picture } from 'astro:assets';
import type { Category } from '../../lib/products';

interface Props {
  categories: (Category & { count: number })[];
}

const tiles = Astro.props.categories.map((c) => ({
  category: c.id,
  label: c.data.name,
  photo: c.data.photo,
  count: c.count,
}));
const names = tiles.map((t) => t.label.toLowerCase());
const mixList =
  names.length > 1 ? `${names.slice(0, -1).join(', ')} y ${names.at(-1)}` : (names[0] ?? '');
---

<section class="categories" aria-labelledby="categories-title">
  <div class="wrap">
    <h2 id="categories-title" class="voice-title text-h2">
      Tenemos varios tipos de productos para vos!
    </h2>
    <p class="intro measure">
      Mezclá {mixList} como quieras. Para el mínimo cuenta todo junto.
    </p>
    <ul class="mosaic">
      {tiles.map((t, i) => (
        <li class:list={['tile', { 'tile-lead': i === 0 }]}>
          <a href={`/catalogo?rubro=${t.category}`}>
            {t.photo ? (
              <Picture
                src={t.photo}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[320, 480, 720, 960]}
                sizes={
                  i === 0 ? '(min-width: 64rem) 42rem, 100vw' : '(min-width: 64rem) 30rem, 50vw'
                }
              />
            ) : (
              <span class="placeholder">
                <span class="ph-kicker">Foto pendiente</span>
                <span class="ph-label">Rubro {t.label.toLowerCase()}</span>
              </span>
            )}
            <span class="label">
              <span class="name">{t.label}</span>
              {/* <span class="count">{t.count === 1 ? '1 producto' : `${t.count} productos`}</span> */}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .categories {
    background: var(--color-paper);
    padding-block: var(--space-section);
  }

  h2 {
    margin: 0;
  }

  .intro {
    margin: 0.75rem 0 2rem;
    color: var(--color-muted);
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile-lead {
    grid-column: 1 / -1;
  }

  .tile a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-white);
  }

  .tile :global(img),
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--aspect-category);
    object-fit: cover;
  }

  .tile-lead :global(img),
  .tile-lead .placeholder {
    aspect-ratio: 4 / 3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile :global(img) {
      transition: transform 0.4s ease;
    }

    .tile a:hover :global(img),
    .tile a:focus-visible :global(img) {
      transform: scale(1.06);
    }
  }

  @media (max-width: 63.99rem) {
    /* A last tile left alone in its row takes the whole row. */
    .tile:nth-child(even):last-child {
      grid-column: 1 / -1;
    }

    .tile:nth-child(even):last-child :global(img),
    .tile:nth-child(even):last-child .placeholder {
      aspect-ratio: 2 / 1;
    }
  }

  /* No photo yet: the tile itself is the dashed frame, so the label always sits on it. */
  .placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1rem 1rem 4.5rem;
    color: var(--color-muted);
    text-align: center;
  }

  .placeholder::before {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 2px dashed rgb(38 38 38 / 0.3);
  }

  .ph-kicker {
    font-size: var(--text-small);
  }

  .ph-label {
    color: var(--color-charcoal);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .label {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem 0.7rem;
    background: var(--color-charcoal);
    color: var(--color-white);
  }

  .name {
    font-size: var(--text-h4);
    font-style: italic;
    font-weight: 900;
    line-height: 1.05;
  }

  .tile-lead .name {
    font-size: var(--text-h3);
  }

  .count {
    color: var(--color-mist);
    font-size: var(--text-small);
  }

  .tile a:hover .label {
    background: var(--color-magenta-dark);
  }

  .tile a:hover .count {
    color: var(--color-white);
  }

  @media (min-width: 64rem) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 17rem;
      gap: 1.5rem;
    }

    .tile {
      grid-column: span 4;
    }

    /* First category large on the left, the next two stacked beside it, the rest in rows of 3. */
    .tile-lead {
      grid-column: 1 / 8;
      grid-row: span 2;
    }

    .tile-lead + .tile,
    .tile-lead + .tile + .tile {
      grid-column: 8 / 13;
    }

    /* Fill the last row when the extra categories don't come in threes. */
    .tile:nth-child(3n + 4):last-child {
      grid-column: 1 / -1;
    }

    .tile:nth-child(3n + 4):nth-last-child(2),
    .tile:nth-child(3n + 5):last-child {
      grid-column: span 6;
    }

    .tile :global(img),
    .tile-lead :global(img),
    .tile .placeholder {
      aspect-ratio: auto;
    }
  }
</style>
