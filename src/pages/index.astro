---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import Categories from '../components/home/Categories.astro';
import Featured from '../components/home/Featured.astro';
import HowToBuy from '../components/home/HowToBuy.astro';
import RealStore from '../components/home/RealStore.astro';
import Guarantee from '../components/home/Guarantee.astro';
import Season from '../components/home/Season.astro';
import Faq from '../components/home/Faq.astro';
import ClosingCta from '../components/home/ClosingCta.astro';
import { getSettings, hasWhatsApp } from '../lib/settings';
import { getProducts, getCategories } from '../lib/products';
import { isPending } from '../lib/text';
import { WEEKDAYS } from '../lib/opening-hours';

const settings = await getSettings();
const products = await getProducts();
const featured = products.filter((p) => p.data.featured && p.data.available).slice(0, 8);
const categories = (await getCategories()).map((c) => ({
  ...c,
  count: products.filter((p) => p.data.category === c.id).length,
}));
// Hero picks: chosen in the panel, otherwise the first 3 featured.
const picked = (settings.heroProducts ?? [])
  .map((slug) => products.find((p) => p.id === slug && p.data.available))
  .filter((p) => p !== undefined);
const heroMix = picked.length > 0 ? picked : featured.slice(0, 3);

const site = Astro.site ?? new URL('https://rosalumayorista.almarweb.workers.dev');
const dayNames: Record<(typeof WEEKDAYS)[number], string> = {
  monday: 'Monday',
  tuesday: 'Tuesday',
  wednesday: 'Wednesday',
  thursday: 'Thursday',
  friday: 'Friday',
  saturday: 'Saturday',
  sunday: 'Sunday',
};
const storeLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WholesaleStore',
  name: 'Rosalu',
  description: settings.copy.heroSubtitle,
  url: site.href,
  image: new URL('/og.png', site).href,
  priceRange: '$',
  currenciesAccepted: 'ARS',
  paymentAccepted: 'Efectivo, transferencia',
  areaServed: { '@type': 'State', name: 'Jujuy' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: isPending(settings.address.number)
      ? settings.address.street
      : `${settings.address.street} ${settings.address.number}`,
    addressLocality: settings.address.city,
    addressRegion: 'Jujuy',
    addressCountry: 'AR',
  },
  openingHoursSpecification: settings.hours
    .filter((h) => !h.closed && h.opens && h.closes)
    .flatMap((h) =>
      [
        [h.opens, h.closes],
        [h.reopens, h.closesLate],
      ]
        .filter(([opens, closes]) => opens && closes)
        .map(([opens, closes]) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: dayNames[h.day],
          opens,
          closes,
        })),
    ),
};
if (hasWhatsApp(settings)) storeLd.telephone = `+${settings.whatsapp}`;
if (!isPending(settings.mapsUrl)) storeLd.hasMap = settings.mapsUrl;
const sameAs = Object.values(settings.social).filter((url) => !isPending(url));
if (sameAs.length) storeLd.sameAs = sameAs;
---

<BaseLayout
  title="Rosalu"
  description="Mayorista desde 3 productos en San Salvador de Jujuy. Ropa, juguetería y bazar con precios publicados, surtido y cambio en 24 horas. Retiro en el local de calle Gorriti."
>
  <JsonLd slot="head" data={storeLd} />

  <Hero settings={settings} sampleMix={heroMix} />
  <TrustStrip settings={settings} />
  <Categories categories={categories} />
  <Featured products={featured} />
  <HowToBuy settings={settings} />
  <RealStore settings={settings} />
  <Guarantee settings={settings} />
  <Season settings={settings} />
  <Faq settings={settings} />
  <ClosingCta settings={settings} />

  <WhatsAppFab slot="after" settings={settings} />
</BaseLayout>
