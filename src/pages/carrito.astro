---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PendingValue from '../components/PendingValue.astro';
import { getSettings, hasWhatsApp, surchargeLabel } from '../lib/settings';

const settings = await getSettings();
const surcharge = surchargeLabel(settings);
---

<BaseLayout
  title="Tu pedido"
  description="Revisá tu pedido y mandalo por WhatsApp. Lo retirás en el local de Rosalu."
  noindex
>
  <div
    class="wrap page"
    data-cart-page
    data-min-units={settings.minUnits}
    data-whatsapp={hasWhatsApp(settings) ? settings.whatsapp : ''}
  >
    <h1 class="voice-title text-h1">Tu pedido</h1>

    <noscript>
      <p class="notice">
        Para armar el pedido necesitás tener JavaScript activado en el navegador.
      </p>
    </noscript>

    <div class="empty" data-empty hidden>
      <p class="lead">Tu carrito está vacío.</p>
      <p>Mirá el catálogo, elegí lo que querés y volvé acá para mandar el pedido.</p>
      <Button href="/catalogo">Ver catálogo</Button>
    </div>

    <div class="layout" data-filled hidden>
      <div class="lines-col">
        <div class="notices" aria-live="polite" data-notices></div>
        <ul class="lines" data-lines></ul>
        <Button variant="text" data-clear>
          Vaciar carrito
        </Button>
      </div>

      <aside class="summary" aria-labelledby="summary-title">
        <h2 id="summary-title" class="sr-only">
          Resumen del pedido
        </h2>
        <p class="minimum notice" aria-live="polite" data-minimum hidden></p>
        <dl class="totals">
          <div>
            <dt>Unidades</dt>
            <dd data-units>0</dd>
          </div>
          <div class="total-row">
            <dt>Total estimado en efectivo</dt>
            <dd>
              <span class="total voice-tag" data-total>
                $ 0
              </span>
            </dd>
          </div>
        </dl>
        <p class="surcharge">
          {surcharge ? (
            `Con Mercado Pago o transferencia, +${surcharge} por producto.`
          ) : (
            <PendingValue label="recargo por Mercado Pago o transferencia" />
          )}
        </p>

        <form class="send" data-send-form>
          <label for="customer-name">
            Tu nombre <span class="optional">(opcional)</span>
          </label>
          <input
            id="customer-name"
            name="name"
            type="text"
            autocomplete="given-name"
            maxlength="60"
          />
          <div class="send-bar">
            {hasWhatsApp(settings) ? (
              <Button type="submit" full>
                <Icon name="whatsapp" />
                Enviar pedido por WhatsApp
              </Button>
            ) : (
              <Button type="button" full disabled>
                WhatsApp: falta cargar el número
              </Button>
            )}
          </div>
          <p class="pickup">Lo retirás en el local. Te confirmamos disponibilidad por WhatsApp.</p>
        </form>
      </aside>
    </div>
  </div>

  <template id="line-template">
    <li class="line">
      <span class="line-photo" data-photo></span>
      <div class="line-info">
        <a class="line-name" data-name></a>
        <p class="line-variant" data-variant></p>
        <p class="line-price" data-price></p>
        <p class="line-excluded" data-excluded></p>
      </div>
      <div class="line-actions">
        <div class="stepper" data-stepper>
          <button type="button" data-step="-1">
            <Icon name="minus" size={18} />
          </button>
          <input type="number" inputmode="numeric" min="1" max="999" data-qty />
          <button type="button" data-step="1">
            <Icon name="plus" size={18} />
          </button>
        </div>
        <button type="button" class="remove" data-remove>
          Quitar
        </button>
      </div>
    </li>
  </template>

  <dialog class="confirm" data-confirm aria-labelledby="confirm-title">
    <form method="dialog">
      <h2 id="confirm-title" class="voice-title text-h4">
        ¿Vaciar el carrito?
      </h2>
      <p>Se borran todos los productos que elegiste.</p>
      <div class="confirm-actions">
        <Button type="submit" variant="outline-dark" value="cancel">
          No, dejarlo
        </Button>
        <Button type="submit" value="clear">
          Sí, vaciar
        </Button>
      </div>
    </form>
  </dialog>
</BaseLayout>

<script>
  import '../scripts/cart-page';
</script>

<style>
  .page {
    min-height: 85svh;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) var(--space-section);
  }

  h1 {
    margin: 0 0 1.5rem;
  }

  .lead {
    margin: 0 0 0.5rem;
    font-size: var(--text-h4);
    font-weight: 700;
  }

  .empty p:not(.lead) {
    margin: 0 0 1.5rem;
  }

  .layout {
    display: grid;
    gap: 2rem;
  }

  .notice,
  .notices :global(.notice) {
    margin: 0 0 0.75rem;
    padding: 0.85rem 1rem;
    border: 2px solid var(--color-charcoal);
    font-weight: 500;
  }

  .notices :global(.notice strong) {
    font-weight: 700;
  }

  .lines {
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  :global(.line) {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.5rem 0.85rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  :global(.line-photo) {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    background: var(--color-white);
  }

  :global(.line-photo img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.line-info p) {
    margin: 0.1rem 0 0;
  }

  :global(.line-name) {
    font-weight: 700;
    text-decoration: none;
  }

  :global(.line-name:hover) {
    text-decoration: underline;
  }

  :global(.line-variant),
  :global(.line-price) {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  :global(.line-excluded) {
    color: var(--color-magenta-dark);
    font-weight: 700;
    font-size: var(--text-small);
  }

  :global(.line-excluded:empty) {
    display: none;
  }

  :global(.line.is-excluded .line-photo img) {
    filter: grayscale(1);
    opacity: 0.55;
  }

  :global(.line.is-excluded [data-stepper]) {
    display: none;
  }

  :global(.line-actions) {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  :global(.line .stepper) {
    display: inline-flex;
    border: 2px solid var(--color-charcoal);
    border-radius: var(--radius-field);
  }

  :global(.line .stepper button) {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
  }

  :global(.line .stepper input) {
    width: 3rem;
    border: 0;
    border-inline: 2px solid var(--color-charcoal);
    font: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  :global(.line .stepper input::-webkit-inner-spin-button),
  :global(.line .stepper input::-webkit-outer-spin-button) {
    -webkit-appearance: none;
    margin: 0;
  }

  :global(.remove) {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--color-magenta-dark);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    cursor: pointer;
  }

  .summary {
    align-self: start;
  }

  .totals {
    margin: 0;
  }

  .totals div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .totals dt {
    font-weight: 600;
  }

  .totals dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .total-row {
    flex-wrap: wrap;
    border-top: 2px solid var(--color-charcoal);
    padding-top: 0.85rem !important;
  }

  .total {
    font-size: var(--text-tag-md);
    line-height: 1;
  }

  .surcharge {
    margin: 0.5rem 0 1.5rem;
    color: var(--color-muted);
  }

  .send label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .optional {
    color: var(--color-muted);
    font-weight: 400;
  }

  .send input {
    width: 100%;
    min-height: 3rem;
    margin-bottom: 1rem;
    padding: 0.6rem 0.85rem;
    border: 2px solid var(--color-charcoal);
    border-radius: var(--radius-field);
    font: inherit;
  }

  .pickup {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .confirm {
    max-width: min(26rem, calc(100% - 2rem));
    padding: 1.5rem;
    border: 2px solid var(--color-charcoal);
    border-radius: 0;
  }

  .confirm::backdrop {
    background: rgb(38 38 38 / 0.6);
  }

  .confirm h2 {
    margin: 0 0 0.5rem;
  }

  .confirm p {
    margin: 0 0 1.25rem;
  }

  .confirm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .lines-col {
      grid-column: 1 / 8;
    }

    .summary {
      grid-column: 9 / 13;
      position: sticky;
      top: 5.5rem;
    }

    :global(.line) {
      grid-template-columns: 5rem minmax(0, 1fr) auto;
      align-items: center;
    }

    :global(.line-photo) {
      width: 5rem;
      height: 5rem;
    }

    :global(.line-actions) {
      grid-column: 3;
    }
  }
</style>
