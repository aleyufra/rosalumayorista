---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import MarketTag from '../../components/MarketTag.astro';
import ProductCard from '../../components/ProductCard.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import PendingValue from '../../components/PendingValue.astro';
import JsonLd from '../../components/JsonLd.astro';
import {
  getProducts,
  thumbnailUrl,
  productUrl,
  getCategoryLabels,
  type Product,
} from '../../lib/products';
import { getSettings, hasWhatsApp, surchargeLabel } from '../../lib/settings';
import { formatPrice } from '../../lib/price';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}

interface Props {
  product: Product;
  all: Product[];
}

const { product, all } = Astro.props;
const { name, category, subcategory, cashPrice, photos, sizes, colors, available, description } =
  product.data;
const settings = await getSettings();
const CATEGORY_LABELS = await getCategoryLabels();
const surcharge = surchargeLabel(settings);
const related = all
  .filter((p) => p.id !== product.id && p.data.category === category && p.data.available)
  .slice(0, 4);
const thumb = await thumbnailUrl(product);
const cover = photos[0];
const shareImage = cover
  ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src
  : '/og.png';
const site = Astro.site ?? new URL('https://rosalumayorista.almarweb.workers.dev');
const askBackUrl = hasWhatsApp(settings)
  ? buildWhatsAppUrl(settings.whatsapp, `¡Hola Rosalu! Quería saber cuándo vuelve: ${name}`)
  : undefined;

const missingLabel =
  sizes.length && colors.length
    ? 'Elegí talle y color'
    : sizes.length
      ? 'Elegí un talle'
      : 'Elegí un color';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description:
    description ?? `${name}. ${CATEGORY_LABELS[category] ?? category} a precio mayorista en Rosalu, Jujuy.`,
  image: new URL(shareImage, site).href,
  category: CATEGORY_LABELS[category] ?? category,
  brand: { '@type': 'Brand', name: 'Rosalu' },
  offers: {
    '@type': 'Offer',
    price: cashPrice,
    priceCurrency: 'ARS',
    availability: available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: new URL(productUrl(product.id), site).href,
    seller: { '@type': 'Organization', name: 'Rosalu' },
  },
};
---

<BaseLayout
  title={`${name}, ${formatPrice(cashPrice)}`}
  description={`${name} a ${formatPrice(cashPrice)} en efectivo. ${CATEGORY_LABELS[category] ?? category} mayorista desde ${settings.minUnits} productos surtidos. Retiro en el local de calle Gorriti, Jujuy.`}
  image={shareImage}
>
  <JsonLd slot="head" data={productLd} />

  <div class="wrap page">
    <nav class="crumbs" aria-label="Estás en">
      <a href="/catalogo">Catálogo</a>
      <span aria-hidden="true">/</span>
      <a href={`/catalogo?rubro=${category}`}>{CATEGORY_LABELS[category] ?? category}</a>
    </nav>

    <div class="layout">
      <div class="media">
        <Gallery photos={photos} name={name} slug={product.id} soldOut={!available} />
      </div>

      <div class="info">
        <p class="category">
          {CATEGORY_LABELS[category] ?? category}
          {subcategory && <span> de {subcategory.toLowerCase()}</span>}
        </p>
        <h1 class="voice-title text-h2">{name}</h1>

        <div class="price">
          {available ? (
            <MarketTag size="md">{formatPrice(cashPrice)}</MarketTag>
          ) : (
            <MarketTag size="md" tone="charcoal">
              Agotado
            </MarketTag>
          )}
        </div>
        <p class="price-note">
          Precio en efectivo.{' '}
          {surcharge ? (
            `Por transferencia, +${surcharge}.`
          ) : (
            <PendingValue label="recargo por transferencia" />
          )}
        </p>

        {description && <p class="description measure">{description}</p>}

        {available ? (
          <form
            class="buy"
            data-add-form
            data-slug={product.id}
            data-name={name}
            data-price={cashPrice}
            data-photo={thumb}
            data-missing-label={missingLabel}
            novalidate
          >
            {sizes.length > 0 && (
              <fieldset class="options" data-required="size">
                <legend>Talle</legend>
                <div class="option-list">
                  {sizes.map((size) => (
                    <label class="option">
                      <input type="radio" name="size" value={size} />
                      <span>{size}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}

            {colors.length > 0 && (
              <fieldset class="options" data-required="color">
                <legend>Color</legend>
                <div class="option-list">
                  {colors.map((color) => (
                    <label class="option">
                      <input type="radio" name="color" value={color.name} />
                      <span>
                        {color.hex && (
                          <i class="dot" style={`background:${color.hex}`} aria-hidden="true" />
                        )}
                        {color.name}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}

            <div class="quantity">
              <label for="quantity">Cantidad</label>
              <div class="stepper">
                <button type="button" data-step="-1" aria-label="Restar uno">
                  <Icon name="minus" size={20} />
                </button>
                <input
                  id="quantity"
                  name="quantity"
                  type="number"
                  inputmode="numeric"
                  min="1"
                  max="999"
                  value="1"
                />
                <button type="button" data-step="1" aria-label="Sumar uno">
                  <Icon name="plus" size={20} />
                </button>
              </div>
            </div>

            <p class="missing" data-missing aria-live="polite"></p>

            <div class="inline-action" data-inline-action>
              <Button type="submit" full data-add-button>
                {sizes.length || colors.length ? missingLabel : 'Agregar al carrito'}
              </Button>
            </div>

            {/* Mobile only: appears when neither the price nor the in-page button is on screen. */}
            <div class="buy-bar" data-buy-bar hidden>
              <span class="bar-price voice-tag" aria-hidden="true">
                {formatPrice(cashPrice)}
              </span>
              <Button type="submit" full data-add-button tabindex="-1">
                {sizes.length || colors.length ? missingLabel : 'Agregar al carrito'}
              </Button>
            </div>
          </form>
        ) : (
          <div class="sold-out-box">
            <p>Este producto se agotó. Preguntanos cuándo vuelve y te avisamos.</p>
            {askBackUrl ? (
              <Button href={askBackUrl} variant="outline-dark" target="_blank" rel="noopener">
                Consultar por WhatsApp cuándo vuelve
              </Button>
            ) : (
              <PendingValue label="número de WhatsApp" />
            )}
          </div>
        )}

        <ul class="trust">
          <li>
            <strong>Retiro en el local.</strong> No hacemos envíos.
          </li>
          <li>
            <strong>Cambio en 24 hs</strong> con ticket, sin uso y con etiqueta.
          </li>
          <li>
            <strong>Mínimo {settings.minUnits} productos</strong>, surtidos entre todos los rubros.
          </li>
        </ul>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title" class="voice-title text-h3">
          Más de {(CATEGORY_LABELS[category] ?? category).toLowerCase()}
        </h2>
        <ul class="related-grid">
          {related.map((p) => (
            <li>
              <ProductCard product={p} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <div class="toast" role="status" aria-live="polite" data-toast hidden>
    <span>Agregado al carrito.</span>
    <a href="/carrito">Ver carrito</a>
  </div>
</BaseLayout>

<script>
  import '../../scripts/product';
</script>

<style>
  .page {
    padding-block: 1rem var(--space-section);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .layout {
    display: grid;
    gap: 1.5rem;
  }

  .media {
    margin-inline: calc(var(--gutter) * -1);
  }

  .category {
    margin: 0;
    color: var(--color-muted);
    font-weight: 600;
  }

  h1 {
    margin: 0.25rem 0 1.25rem;
  }

  .price {
    margin-left: -0.35rem;
  }

  .price-note {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
  }

  .description {
    margin: 1.25rem 0 0;
  }

  .buy {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .options {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .options legend,
  .quantity label {
    margin-bottom: 0.5rem;
    padding: 0;
    font-weight: 700;
  }

  .options:global(.is-missing) legend {
    color: var(--color-magenta-dark);
  }

  .option-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    position: relative;
  }

  .option input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .option span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    justify-content: center;
    border: 2px solid var(--color-charcoal);
    border-radius: var(--radius-field);
    font-weight: 600;
    cursor: pointer;
  }

  .option input:checked + span {
    background: var(--color-charcoal);
    color: var(--color-white);
  }

  .option input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }

  .option input:checked + span .dot {
    box-shadow: 0 0 0 2px var(--color-white);
  }

  .quantity label {
    display: block;
  }

  .stepper {
    display: inline-flex;
    border: 2px solid var(--color-charcoal);
    border-radius: var(--radius-field);
  }

  .stepper button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
  }

  .stepper button:hover {
    background: var(--color-paper);
  }

  .stepper input {
    width: 3.5rem;
    border: 0;
    border-inline: 2px solid var(--color-charcoal);
    font: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .missing {
    min-height: 1.5em;
    margin: -0.5rem 0 0;
    color: var(--color-magenta-dark);
    font-weight: 600;
  }

  .missing:empty {
    display: none;
  }

  /* Mobile: price and action stay reachable at the bottom of the screen. */
  .buy-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: var(--color-white);
    border-top: 1px solid var(--color-rule);
  }

  .bar-price {
    flex: none;
    font-size: 1.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .buy-bar:not([hidden]) {
      animation: bar-in 200ms var(--ease-settle);
    }
  }

  @keyframes bar-in {
    from {
      transform: translateY(100%);
    }
  }

  :global(body:has([data-add-form])) {
    padding-bottom: 5.5rem;
  }

  .sold-out-box {
    margin-top: 1.75rem;
    padding: 1rem;
    border: 2px solid var(--color-charcoal);
  }

  .sold-out-box p {
    margin: 0 0 1rem;
  }

  .trust {
    display: grid;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-rule);
    list-style: none;
  }

  .related {
    margin-top: var(--space-section);
  }

  .related h2 {
    margin: 0 0 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(5.5rem + env(safe-area-inset-bottom));
    z-index: 35;
    display: flex;
    gap: 1rem;
    align-items: center;
    width: max-content;
    max-width: calc(100% - 2rem);
    padding: 0.75rem 1rem;
    background: var(--color-charcoal);
    color: var(--color-white);
    font-weight: 600;
    transform: translateX(-50%);
    --color-focus: var(--color-white);
  }

  .toast a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: underline;
    text-decoration-color: var(--color-magenta);
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toast:not([hidden]) {
      animation: toast-in 260ms var(--ease-settle);
    }
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 0.75rem);
    }
  }

  @media (min-width: 48rem) {
    .related-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }

    .media {
      grid-column: 1 / 8;
      margin-inline: 0;
    }

    .info {
      grid-column: 8 / 13;
      position: sticky;
      top: 5rem;
    }

    .buy-bar {
      display: none !important;
    }

    :global(body:has([data-add-form])) {
      padding-bottom: 0;
    }

    .toast {
      bottom: 2rem;
    }
  }
</style>
